{
  "manifest_version":3,"name":"Print Platform Bridge","version":"0.1.0",
  "description":"Allow approved business pages to communicate with the local print agent.",
  "permissions":["storage"],"host_permissions":["http://127.0.0.1:18181/*"],
  "background":{"service_worker":"src/background.js"},
  "content_scripts":[{"matches":["http://localhost/*","https://localhost/*","http://127.0.0.1/*","https://127.0.0.1/*"],"js":["src/content.js"],"run_at":"document_start"}]
}